# NASA FIRMS API key — free at https://firms.modaps.eosdis.nasa.gov/api/area/
# Powers live VIIRS satellite fire detection (local dev falls back to a
# baseline snapshot when unset). Also set as a GitHub Actions secret
# (FIRMS_MAP_KEY) for the scheduled data-update workflow.
FIRMS_MAP_KEY=

# GitHub token with public_repo scope — used by the Cloudflare Pages
# Function (functions/api/memorial/submit.ts) to file memorial submission
# issues. Leave empty locally unless testing submissions.
GITHUB_TOKEN=
