{
  "name": "oilburntracker",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Sujaya Nimneth",
    "url": "https://github.com/Sujaya-Nimneth/Oil-Burn-Tracker"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "update:headlines": "node scripts/headline-monitor.js --publish",
    "update:stats": "node scripts/daily-stats-update.js --no-git",
    "update:firms": "node scripts/fetch-firms-snapshot.js",
    "update:all": "npm run update:headlines && npm run update:stats && npm run update:firms",
    "pages:build": "next build",
    "pages:deploy": "npx wrangler pages deploy out"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,css,md}": "prettier --write"
  },
